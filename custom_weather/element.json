{
    "name": "custom_weather",
    "title": "Weather",
    "group": "Custom",
    "icon": "${url:images/icon.svg}",
    "iconSmall": "${url:images/iconSmall.svg}",
    "element": true,
    "width": 500,
    "templates": {
        "render": "./templates/template.php",
        "content": "./templates/content.php"
    },
    "@import": "./element.php",
    "fields": {
        "api_key": {
            "label": "OpenWeatherMap API Key",
            "description": "Enter your API key from OpenWeatherMap.",
            "type": "text"
        },
        "location": {
            "label": "Manual Location",
            "description": "Enter city and country code (e.g., London,UK). Used if 'Detect Location Automatically' is off or fails.",
            "type": "text"
        },
        "auto_location": {
            "label": "Detect Location Automatically",
            "description": "Attempt to detect user's location based on IP address. Manual Location is used as a fallback.",
            "type": "checkbox",
            "text": "Enable automatic location detection",
            "default": false
        },
        "units": {
            "label": "Units",
            "type": "select",
            "default": "metric",
            "options": {
                "Celsius (Metric)": "metric",
                "Fahrenheit (Imperial)": "imperial"
            }
        },
        "cache_duration": {
            "label": "Cache Duration (seconds)",
            "description": "How long to cache the weather data. Default is 3600 seconds (1 hour).",
            "type": "number",
            "default": 3600
        },
        "show_humidity": {
            "label": "Humidity Display",
            "type": "checkbox",
            "text": "Show Humidity Information",
            "default": true
        },
        "show_wind": {
            "label": "Wind Speed Display",
            "type": "checkbox",
            "text": "Show Wind Speed Information",
            "default": true
        },
        "forecast_days": {
            "label": "Forecast Days",
            "description": "Number of forecast days to display (0-7). Note: OpenWeatherMap free tier provides 5-day/3-hour forecast. Daily forecast might require a paid plan for extensive range.",
            "type": "number",
            "default": 0,
            "attrs": {
                "min": 0,
                "max": 7
            }
        },
        "css": {
            "type": "editor",
            "label": "CSS",
            "description": "Enter your own custom CSS.",
            "editor": "code",
            "mode": "css",
            "attrs": {
                "debounce": 500
            }
        },
        "status": "${builder.status}",
        "source": "${builder.source}",
        "id": "${builder.id}",
        "class": "${builder.cls}",
        "attributes": "${builder.attrs}"
    },
    "fieldset": {
        "default": {
            "type": "tabs",
            "fields": [
                {
                    "title": "Content",
                    "fields": [
                        "api_key",
                        "auto_location",
                        "location",
                        {
                            "label": "Display Options",
                            "type": "group",
                            "divider": true,
                            "fields": ["units", "cache_duration"]
                        }
                    ]
                },
                {
                    "title": "Settings",
                    "fields": [
                        "show_humidity",
                        "show_wind",
                        "forecast_days"
                    ]
                },
                "${builder.advanced}"
            ]
        }
    },
    "defaults": {
        "units": "metric",
        "cache_duration": 3600,
        "auto_location": false,
        "show_humidity": true,
        "show_wind": true,
        "forecast_days": 0
    }
}
