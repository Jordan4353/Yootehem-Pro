{
    "@import": "./element.php",
    "name": "youtube_feed",
    "title": "YouTube Feed",
    "group": "Custom",
    "icon": "${url:images/icon.svg}",
    "iconSmall": "${url:images/iconSmall.svg}",
    "element": true,
    "width": 500,
    "defaults": {
        "source_type": "channel",
        "api_key": "",
        "channel_id": "",
        "playlist_id": "",
        "video_ids": "",
        "video_count": 6,
        "layout": "grid",
        "show_title": true,
        "show_description": false,
        "description_max_length": 100,
        "player_controls": true,
        "player_modest_branding": false,
        "player_loop": false,
        "use_youtube_nocookie": true,
        "cache_duration": 60
    },
    "templates": {
        "render": "./templates/template.php",
        "content": "./templates/content.php"
    },
    "fields": {
        "api_key": {
            "label": "YouTube API Key",
            "type": "text",
            "description": "Required. Get one from Google Cloud Console. Supports Dynamic Content.",
            "attrs": { "required": true },
            "source": true
        },
        "source_type": {
            "label": "Content Source",
            "type": "select",
            "default": "channel",
            "options": {
                "YouTube Channel": "channel",
                "YouTube Playlist": "playlist",
                "Specific Video(s)": "videos"
            }
        },
        "channel_id": {
            "label": "YouTube Channel ID",
            "type": "text",
            "description": "Enter Channel ID (e.g., UCXXXXX). Supports Dynamic Content.",
            "attrs": { "required": true },
            "show": "source_type == 'channel'",
            "source": true
        },
        "playlist_id": {
            "label": "YouTube Playlist ID",
            "type": "text",
            "description": "Enter Playlist ID (e.g., PLXXXXX). Supports Dynamic Content.",
            "attrs": { "required": true },
            "show": "source_type == 'playlist'",
            "source": true
        },
        "video_ids": {
            "label": "Specific Video IDs",
            "type": "textarea",
            "description": "Comma-separated Video IDs (e.g., videoID1,videoID2). Max 50. Supports Dynamic Content.",
            "attrs": { "rows": 3, "required": true },
            "show": "source_type == 'videos'",
            "source": true
        },
        "video_count": {
            "label": "Max Videos to Display",
            "type": "number",
            "default": 6,
            "description": "Applies to Channel and Playlist sources. Max 50.",
            "attrs": { "min": 1, "max": 50, "step": 1 },
            "show": "source_type == 'channel' || source_type == 'playlist'"
        },
        "heading_layout_display": { "type": "heading", "label": "Layout & Display" },
        "layout": {
            "label": "Layout",
            "type": "select",
            "default": "grid",
            "options": { "Grid": "grid", "List": "list" }
        },
        "show_title": {
            "label": "Show Video Titles",
            "type": "checkbox",
            "text": "Display the title for each video."
        },
        "show_description": {
            "label": "Show Video Descriptions",
            "type": "checkbox",
            "text": "Display the description for each video."
        },
        "description_max_length": {
            "label": "Description Max Length",
            "type": "number",
            "attrs": { "min": 20, "max": 500, "step": 10 },
            "show": "show_description"
        },
        "heading_player_options": { "type": "heading", "label": "Player Options" },
        "player_controls": {
            "label": "Show Player Controls",
            "type": "checkbox",
            "text": "Display video player controls."
        },
        "player_modest_branding": {
            "label": "Modest YouTube Branding",
            "type": "checkbox",
            "text": "Reduce YouTube logo visibility in the player."
        },
        "player_loop": {
            "label": "Loop Video(s)",
            "type": "checkbox",
            "text": "Enable video looping."
        },
        "heading_caching": { "type": "heading", "label": "Caching" },
        "cache_duration": {
            "label": "Cache Duration (Minutes)",
            "type": "number",
            "description": "How long to cache YouTube API results. 0 to disable.",
            "attrs": { "min": 0, "step": 15 }
        },
        "cache_info": {
            "type": "description",
            "description": "Manual cache clear: append `?clear_yt_cache=YOUR_ELEMENT_ID` to builder URL & reload."
        },
        "heading_privacy": { "type": "heading", "label": "Privacy" },
        "use_youtube_nocookie": {
            "label": "Use YouTube Nocookie Domain",
            "type": "checkbox",
            "text": "Embed using youtube-nocookie.com for enhanced privacy."
        }
    },
    "fieldset": {
        "default": {
            "type": "tabs",
            "fields": [
                {
                    "title": "Content",
                    "fields": [
                        "api_key",
                        "source_type",
                        { "name": "channel_id", "show": "source_type == 'channel'" },
                        { "name": "playlist_id", "show": "source_type == 'playlist'" },
                        { "name": "video_ids", "show": "source_type == 'videos'" },
                        { "name": "video_count", "show": "source_type == 'channel' || source_type == 'playlist'" }
                    ]
                },
                {
                    "title": "Settings",
                    "fields": [
                        "heading_layout_display",
                        "layout",
                        "show_title",
                        "show_description",
                        { "name": "description_max_length", "show": "show_description" },
                        "heading_player_options",
                        "player_controls",
                        "player_modest_branding",
                        "player_loop",
                        "heading_caching",
                        "cache_duration",
                        "cache_info"
                    ]
                },
                {
                    "title": "Advanced",
                    "fields": [
                        "heading_privacy",
                        "use_youtube_nocookie"
                        // Standard YOOtheme Pro advanced fields (Name, Status, ID, Class, Attributes, CSS)
                        // are typically added here automatically by the theme.
                        // If needed, one could reference them using ${builder.advanced} or similar.
                    ]
                }
            ]
        }
    }
}
